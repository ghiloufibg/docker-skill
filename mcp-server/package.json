{
  "name": "docker-skill-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for a Docker fleet dashboard and investigation UI: read-only system card, live Docker ps/inspect/logs/stats, tier-gated mutating actions, and streaming logs/stats. See docs/design/mcp-ui-docker-ops.md.",
  "main": "dist/index.js",
  "bin": {
    "docker-skill-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && cross-env INPUT=mcp-app.html vite build && cross-env INPUT=docker-dashboard.html vite build && cross-env INPUT=investigation-report.html vite build && tsc -p tsconfig.server.json",
    "watch:app": "cross-env INPUT=mcp-app.html vite build --watch",
    "watch:dashboard": "cross-env INPUT=docker-dashboard.html vite build --watch",
    "watch:report": "cross-env INPUT=investigation-report.html vite build --watch",
    "start:stdio": "node dist/index.js --stdio",
    "smoke": "npm run build 1>&2 && node dist/test/smoke.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dockerode": "^5.0.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
